# Supabase project URL and publishable key (safe for browser when RLS is enabled)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Never expose a Supabase secret/service-role key in NEXT_PUBLIC_* variables.
# If a trusted server-only maintenance task needs one later, store it server-side only.
